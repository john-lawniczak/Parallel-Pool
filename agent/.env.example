# === LLM Provider ===
OPENAI_API_KEY=sk-your-openai-api-key-here

# === Monad RPC ===
MONAD_RPC_URL=https://rpc.monad.xyz

# === Agent Wallet (dedicated hot wallet — LOW VALUE ONLY) ===
# This wallet should hold only enough MON for gas.
# NEVER use your deployer wallet or any wallet holding significant funds.
AGENT_PRIVATE_KEY=0xyour-agent-private-key-here

# === Monitor Wallet (separate wallet for 3rd-party reputation feedback) ===
# ERC-8004 reputation is more credible when submitted by an independent observer.
# This wallet watches the agent's txs and submits giveFeedback() from a different address.
# If omitted, the agent wallet submits its own reputation (less credible, still functional).
MONITOR_PRIVATE_KEY=0xyour-monitor-private-key-here

# === Optional Overrides ===
# CYCLE_INTERVAL_MS=15000
# MAX_BORROW_PER_CYCLE=1000
# MAX_GAS_PRICE_GWEI=500
