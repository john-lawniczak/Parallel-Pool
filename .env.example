# Monad Network
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_EXPLORER_KEY=

# Deployment
# Use a Foundry keystore (encrypted on disk), not raw env keys:
# Account name in your local Foundry keystore (safe to store here; not a secret)
ACCOUNT_NAME=
#
# Setup:
#   cast wallet import "$ACCOUNT_NAME" --interactive
# This writes an encrypted keystore to `~/.foundry/keystores/` and will prompt
# you for a password when signing.
#
# Example usage:
#   forge script script/Deploy.s.sol --rpc-url "$MONAD_RPC_URL" --account "$ACCOUNT_NAME" --broadcast

# nad.fun (for token launch)
NADFUN_API_KEY=
